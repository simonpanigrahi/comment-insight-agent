# Copy this file to .env. The agent also runs with no LLM at all (--provider none).
# Choose one provider by leaving its LLM_PROVIDER line uncommented.

# On-premise: a local model through Ollama. No key and no internet needed once it is pulled.
LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:4b

# Free cloud tiers, for sample data only. Keys can stay here whichever provider is active.
# LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_PROVIDER=groq
GROQ_API_KEY=

# Any other OpenAI-compatible server (vLLM, llama.cpp server and so on).
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=your-model
# LLM_API_KEY=not-needed
